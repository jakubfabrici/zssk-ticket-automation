[Unit]
Description=Top up ZSSK zero-fare tickets for the recurring commute
Documentation=https://github.com/jakubfabrici/zssk-ticket-automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/zssk
# xvfb-run gives Firefox a real (virtual) display, so the run is not headless:
# a headless browser is what the site's bot defense rejects first.
# --confirm is deliberate: enable the timer only after a --dry-run has walked
# the whole flow successfully on this machine.
ExecStart=/usr/bin/xvfb-run -a /opt/zssk/.venv/bin/python /opt/zssk/zssk_bulk.py \
    --config /etc/zssk/routes.json --confirm
TimeoutStartSec=3600
Nice=10

[Install]
WantedBy=multi-user.target
